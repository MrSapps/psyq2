; SLUS_007.57 (Quake II, NTSC-U): psylink command file
; Objects are in the original link order (from MAIN.SYM). The text group is the
; part of memory the executable loads; bss and endgroup are zeroed at start-up.

	org	$80018000

text	group
	section	.text, text
	section	.data, text
	section	.rdata, text
	section	.ctors, text
	section	.dtors, text
	section	.sdata, text
	section	CODE, text		; src/hand_asm.s

bss	group	bss
	section	.sbss, bss
	section	.bss, bss

endgroup	group	bss		; after everything: the heap starts at pdhmallocbase
	section	endgroup.text, endgroup
	section	endgroup.data, endgroup
	section	endgroup.rdata, endgroup
	section	endgroup.ctors, endgroup
	section	endgroup.dtors, endgroup
	section	endgroup.sdata, endgroup
	section	endgroup.sbss, endgroup
	section	endgroup.bss, endgroup

